# Password required to access /admin (groups, members, weekly cycles, assignment).
# Set a real value in your deployment environment (or a local .env.local file)
# and restart the app. Without it, /admin login is disabled. Also used to
# derive the admin session-signing secret (see src/lib/auth.ts).
ADMIN_PASSWORD=change-me

# Postgres connection string. All app data (groups, members, cycles,
# commitments, assignments) lives in a single JSONB row in this database.
# On Vercel, attaching a Postgres/Neon store to the project sets this
# automatically. Locally, point it at any Postgres instance.
POSTGRES_URL=postgres://user:password@host:5432/dbname
